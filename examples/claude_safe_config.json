{
  "version": 1,
  "allowedTools": [
    "Read",
    "Glob",
    "Grep"
  ],
  "deniedCommandPatterns": [
    "(^|\\s)(rm\\s+-rf|git\\s+reset\\s+--hard|sudo|chmod\\s+777)(\\s|$)",
    "curl[^|]+\\|\\s*(sh|bash)"
  ],
  "approvalCommandPatterns": [
    "\\bgit\\s+(push|commit)\\b",
    "\\b(npm|pnpm|yarn)\\s+publish\\b",
    "\\b(deploy|terraform\\s+apply)\\b"
  ],
  "allowedCommandPatterns": [
    "^(pwd|ls)$",
    "^(git[ \\t]+status|git[ \\t]+status[ \\t]+--short)$",
    "^(git[ \\t]+diff|git[ \\t]+diff[ \\t]+--stat)$",
    "^(git[ \\t]+log|git[ \\t]+log[ \\t]+--oneline)$"
  ],
  "fileTools": [
    "Read",
    "Edit",
    "Write",
    "Glob",
    "Grep"
  ],
  "auditFile": ".claude/security-audit.jsonl"
}
